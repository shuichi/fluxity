{
  "name": "fluxity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A native WebGPU real-time crowd simulation laboratory.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node --import tsx scripts/benchmark.ts"
  },
  "dependencies": { "gl-matrix": "^3.4.4" },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@webgpu/types": "^0.1.64",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "tsx": "^4.20.0"
  },
  "engines": { "node": ">=22.12.0" }
}
